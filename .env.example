CADDY_API_SITE_ADDRESS=api.yuemanlou.xyz

# 业务镜像 tag 由发布负责人按 YYYYMMDD-<git 短哈希 7 位> 构建推送后填写，
# 禁止带 dirty 后缀、禁止沿用 7 月 6 日快照；postgres / caddy 保持官方镜像 tag（构建推送见 docs/deployment.md §3）。
POSTGRES_IMAGE=ccr.ccs.tencentyun.com/juben-sha/postgres:16-alpine
API_IMAGE=ccr.ccs.tencentyun.com/juben-sha/api:RELEASE_TAG
API_TOOLS_IMAGE=ccr.ccs.tencentyun.com/juben-sha/api-tools:RELEASE_TAG
FASTCLAW_IMAGE=ccr.ccs.tencentyun.com/juben-sha/fastclaw:RELEASE_TAG
CADDY_IMAGE=ccr.ccs.tencentyun.com/juben-sha/caddy:2-alpine

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@postgres:5432/juben_sha

JWT_SECRET=change-me-to-a-long-random-secret
WECHAT_APP_ID=
WECHAT_APP_SECRET=

FASTCLAW_API_KEY=
# 对话生成仅支持 DeepSeek agent（Spec 5：Qwen 停用）；FASTCLAW_AGENT_ID 必须指向 model=siliconflow/deepseek-ai/DeepSeek-V4-Flash 的 FastClaw agent；该 agent 的 thinking 必须为 off（模型级思考默认关闭）
FASTCLAW_AGENT_ID=
FASTCLAW_TIMEOUT_MS=120000
# 不配置降级（Spec 5：Qwen 停用），必须保持 false
FASTCLAW_FALLBACK_ENABLED=false
CHAT_EFFECTS_ASYNC_ENABLED=false
FASTCLAW_STORAGE_DSN=
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENROUTER_API_KEY=

# 上线阻断：真实支付服务商联调未完成；PAYMENT_PROVIDER 必须为 aggregate 且
# merchant/app/secret/notify 四参数齐全方可上线（见 docs/deployment.md §9）。
PAYMENT_PROVIDER=aggregate
PAYMENT_MERCHANT_ID=
PAYMENT_APP_ID=
PAYMENT_SECRET=
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_NOTIFY_URL=https://api.yuemanlou.xyz/api/payments/aggregate/notify
PAYMENT_RETURN_URL=https://api.yuemanlou.xyz

ADMIN_USER_IDS=
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

TEST_USER_INITIAL_POINTS=0
