DATABASE_URL=postgres://postgres:postgres@localhost:5432/juben_sha
JWT_SECRET=change-me-in-production
WECHAT_APP_ID=
WECHAT_APP_SECRET=
FASTCLAW_BASE_URL=http://fastclaw:18953
FASTCLAW_API_KEY=
# 对话生成仅支持 DeepSeek agent（Spec 5：Qwen 停用）；FASTCLAW_AGENT_ID 必须指向 model=siliconflow/deepseek-ai/DeepSeek-V4-Flash 的 FastClaw agent；该 agent 的 thinking 必须为 off（模型级思考默认关闭）
FASTCLAW_AGENT_ID=
FASTCLAW_TIMEOUT_MS=30000
# 不配置降级（Spec 5：Qwen 停用），必须保持 false
FASTCLAW_FALLBACK_ENABLED=false
# 角色 Agent 架构总开关，默认 false 保持旧链路；true 走 19 角色 Agent 新链路（需先完成 FastClaw provisioning + /api/ready 哨兵）
USE_ROLEPLAY_AGENTS=false
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_ID=
PAYMENT_APP_ID=
PAYMENT_SECRET=
PAYMENT_PUBLIC_KEY=
PAYMENT_PRIVATE_KEY=
PAYMENT_NOTIFY_URL=
PAYMENT_RETURN_URL=
ADMIN_USER_IDS=
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
TEST_USER_INITIAL_POINTS=0
