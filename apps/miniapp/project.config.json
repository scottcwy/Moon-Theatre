{
  "appid": "touristappid",
  "projectname": "juben-sha-miniapp",
  "compileType": "miniprogram",
  "miniprogramRoot": "dist/",
  "srcMiniprogramRoot": "src/",
  "libVersion": "3.6.3",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "node_modules"
      },
      {
        "type": "folder",
        "value": "src"
      },
      {
        "type": "folder",
        "value": "config"
      }
    ]
  },
  "setting": {
    "es6": true,
    "postcss": true,
    "minified": true,
    "urlCheck": true,
    "enhance": true,
    "coverView": true,
    "autoAudits": false,
    "showShadowRootInWxmlPanel": true,
    "compileHotReLoad": true,
    "useCompilerPlugins": [
      "typescript"
    ]
  },
  "condition": {}
}
