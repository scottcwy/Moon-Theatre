{
  "name": "juben-sha-miniprogram",
  "private": true,
  "version": "1.0.0",
  "description": "剧本杀角色扮演小程序 - Monorepo",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "pnpm --filter @juben-sha/api dev",
    "dev:miniapp": "pnpm --filter @juben-sha/miniapp dev:weapp",
    "dev:playbook": "pnpm --filter @juben-sha/miniapp-playbook dev:weapp",
    "build:api": "pnpm --filter @juben-sha/api build",
    "build:miniapp": "pnpm --filter @juben-sha/miniapp build:weapp",
    "build:playbook": "pnpm --filter @juben-sha/miniapp-playbook build:weapp",
    "verify:playbook": "pnpm --filter @juben-sha/miniapp-playbook verify:weapp",
    "db:generate": "pnpm --filter @juben-sha/api db:generate",
    "db:migrate": "pnpm --filter @juben-sha/api db:migrate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e:miniapp": "pnpm --filter @juben-sha/miniapp test:e2e:smoke",
    "test:e2e:miniapp:ui": "pnpm --filter @juben-sha/miniapp test:e2e:ui",
    "test:e2e:miniapp:ui:auth": "pnpm --filter @juben-sha/miniapp test:e2e:ui:auth",
    "test:dev-script": "node --test scripts/dev.test.mjs scripts/provision-roleplay-agents.test.mjs",
    "test:deploy-config": "node --test scripts/deploy-config.test.mjs",
    "dev:miniapp:lan": "pnpm --filter @juben-sha/miniapp dev:weapp:lan",
    "build:miniapp:prod": "pnpm --filter @juben-sha/miniapp build:weapp:prod",
    "test:e2e:miniapp:ui:real": "pnpm --filter @juben-sha/miniapp test:e2e:ui:real"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
